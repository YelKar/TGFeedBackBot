{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ─── DEV (окружение по умолчанию): текущий воркер, тестовая база ───
  // Деплой без флага: npm run deploy
  "name": "come-up-with-a-name-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgfeedback",
      "database_id": "75c6aa6b-0de5-4035-977c-74cc995810ba"
    }
  ],

  // Сериализация голосования через Durable Object (SQLite-backed, Free-тариф)
  "durable_objects": {
    "bindings": [
      { "name": "MODERATION", "class_name": "ModerationHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ModerationHub"] }
  ],

  "triggers": {
    "crons": ["* * * * *"]
  },

  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "CHAT_ID": "-1001522287326"
  },

  // ─── PRODUCTION: боевой воркер ───
  // Деплой: npm run deploy:prod
  // Перед первым деплоем:
  //   1. npx wrangler d1 create tgfeedback-prod → database_id ниже
  //   2. npm run db:remote:prod (схема + конфиг scheduler)
  //   3. Секреты TOKEN / CHANNEL_ID / WEBHOOK_SECRET — в дашборде воркера
  //      (Settings → Variables) или: npx wrangler secret put TOKEN --env production
  "env": {
    "production": {
      "name": "come-up-with-a-name-bot-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tgfeedback-prod",
          "database_id": "5588bc0f-dad8-40dd-a1c1-22ddd3921a42"
        }
      ],
      // CHAT_ID задаётся секретом (Dashboard → Variables → Secret),
      // чтобы деплои из CLI его не перезаписывали

      // Не наследуются из топ-уровня — объявляем явно
      "durable_objects": {
        "bindings": [
          { "name": "MODERATION", "class_name": "ModerationHub" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ModerationHub"] }
      ]
    }
  }
}
